+def pcap_class(pcap_file, dataset_type):
+    """Label given to the attack flows of this pcap (1 for binary datasets)."""
+    if dataset_type not in ATTACK_CLASSES:
+        return 1
+    name = os.path.basename(pcap_file).lower()
+    for i, keyword in enumerate(ATTACK_CLASSES[dataset_type].values()):
+        if keyword in name:
+            return i + 1
+    return None # benign-only pcap: attack flows found here would be an error
