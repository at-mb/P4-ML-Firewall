+def dataset_attrs(path):
+    """(class names or None, feature set) stored by lucid_dataset_parser in an hdf5 file"""
+    with h5py.File(glob.glob(path)[0], "r") as f:
+        classes = f.attrs.get('classes', None)
+        feature_set = f.attrs.get('feature_set', 'lucid')
+    if isinstance(classes, bytes):
+        classes = classes.decode()
+    if isinstance(feature_set, bytes):
+        feature_set = feature_set.decode()
+    return (classes.split(',') if classes else None), feature_set
+
+def classes_file(model_path):
+    return model_path[:-len('.h5')] + '-classes.csv'
+
+def model_classes(model_path, model):
+    """Class names of a model: read from <model>-classes.csv, saved next to the .h5"""
+    n_outputs = model.output_shape[-1]
+    if n_outputs == 1:
+        return ['benign', 'ddos']
+    try:
+        with open(classes_file(model_path)) as f:
+            names = [row[1] for row in csv.reader(f) if row and row[0].isdigit()]
+        if len(names) == n_outputs:
+            return names
+    except OSError:
+        pass
+    return ['benign'] + ['class' + str(i) for i in range(1, n_outputs)]
+
+def predict_classes(model, X):
+    """Class index per sample (0 = benign), for both binary and multi-class models"""
+    p = model.predict(X, batch_size=2048, verbose=0)
+    if p.shape[1] == 1:
+        return (p[:, 0] > 0.5).astype(int)
+    return np.argmax(p, axis=1)
