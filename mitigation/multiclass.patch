+# Multi-class extension: categorical fields become bits, lengths are log-scaled.
+# Input: the 9 p4-compatible columns (timestamp, packet_length, IP_flags, TCP_length,
+# TCP_ack, TCP_flags, TCP_window_size, UDP_length, ICMP_type), raw values.
+RICH_FEATURES = 20
+
+def rich_features(sample, time_window):
+    s = np.asarray(sample, dtype=np.float64)
+    if s.shape[1] != 9:
+        raise ValueError("rich features need the 9 p4-compatible features")
+    log16 = np.log(65536.0)
+    cols = [s[:, 0] / time_window]                                   # time since first packet
+    cols += [np.log1p(s[:, j]) / log16 for j in (1, 3, 6, 7)]        # pkt, TCP, window, UDP length
+    cols.append((s[:, 4] > 0).astype(float))                        # ACK number set (raw value is noise)
+    cols.append(s[:, 8] / 255.0)                                     # ICMP type
+    cols += [((s[:, 5].astype(np.int64) >> b) & 1).astype(float) for b in range(9)]  # TCP flags
+    cols += [((s[:, 2].astype(np.int64) >> b) & 1).astype(float) for b in range(3)]  # IP flags (MF, DF, reserved)
+    cols.append((s[:, 1] > 0).astype(float))                        # real packet (padding rows stay 0)
+    return np.stack(cols, axis=1)
