diff --git a/control-plane/mitigation.py b/control-plane/mitigation.py
new file mode 100644
index 0000000..b8153cd
--- /dev/null
+++ b/control-plane/mitigation.py
@@ -0,0 +1,110 @@
+"""Naive mitigation loop: turns LUCID's predictions into drop rules on the switch.
+
+mode 'src'    : one rule per attacking source IP        (table MyIngress.blocked_src)
+mode '5tuple' : one rule per attacking flow direction   (table MyIngress.blocked_flows)
+
+Rules are removed after `timeout` seconds. Addresses in `protect` are never blocked:
+a flow's "source" is only the first endpoint seen in a round, so it can be the victim.
+"""
+import csv
+import ipaddress
+import time
+
+TABLES = {'src': 'MyIngress.blocked_src', '5tuple': 'MyIngress.blocked_flows'}
+ACTION = 'MyIngress.drop'
+
+
+def _ip(addr):
+    return ipaddress.IPv4Address(addr).packed
+
+
+class SwitchTables:
+    """Thin wrapper around the BMv2 Thrift client (runtime_api.client)."""
+
+    def __init__(self, client):
+        # imported here so that this module can be unit-tested without BMv2
+        from bm_runtime.standard import ttypes
+        self.client, self.t = client, ttypes
+
+    def add(self, table, fields):
+        match = [self.t.BmMatchParam(type=self.t.BmMatchParamType.EXACT,
+                                     exact=self.t.BmMatchParamExact(f)) for f in fields]
+        return self.client.bm_mt_add_entry(0, table, match, ACTION, [],
+                                           self.t.BmAddEntryOptions(priority=0))
+
+    def delete(self, table, handle):
+        self.client.bm_mt_delete_entry(0, table, handle)
+
+    def dropped(self, table, handle):
+        return self.client.bm_mt_read_counter(0, table, handle).packets
+
+
+class Mitigator:
+    def __init__(self, tables, mode, timeout=60.0, protect=(), log_path=None, clock=time.time):
+        self.tables, self.mode, self.table = tables, mode, TABLES[mode]
+        self.timeout, self.clock = timeout, clock
+        self.protect = [ipaddress.IPv4Network(p) for p in protect]
+        self.rules = {}  # rule key -> (handle, install time)
+        self.file = open(log_path, 'w', newline='') if log_path else None
+        self.log = csv.writer(self.file) if self.file else None
+        self._write('time', 'event', 'rule', 'dropped_packets', 'active_rules')
+
+    def _write(self, *row):
+        if self.log:
+            self.log.writerow(row)
+            self.file.flush()
+
+    def _protected(self, addr):
+        return any(ipaddress.IPv4Address(addr) in n for n in self.protect)
+
+    def _rule(self, flow):
+        """Rule key for a flagged flow, oriented attacker -> victim, or None."""
+        src, sport, dst, dport, proto = flow
+        if self._protected(src):
+            if self._protected(dst):
+                return None
+            src, sport, dst, dport = dst, dport, src, sport
+        return (src,) if self.mode == 'src' else (src, sport, dst, dport, proto)
+
+    @staticmethod
+    def _encode(rule):
+        if len(rule) == 1:
+            return [_ip(rule[0])]
+        src, sport, dst, dport, proto = rule
+        return [_ip(src), int(sport).to_bytes(2, 'big'), _ip(dst),
+                int(dport).to_bytes(2, 'big'), int(proto).to_bytes(1, 'big')]
+
+    def update(self, flows=(), predictions=()):
+        """Call once per round, also when the round is empty (to expire rules)."""
+        now = self.clock()
+        for rule, (handle, t0) in list(self.rules.items()):
+            if now - t0 >= self.timeout:
+                self._remove(rule, handle, now, 'expire')
+        for flow, malicious in zip(flows, predictions):
+            rule = self._rule(flow) if malicious else None
+            if rule is None or rule in self.rules:
+                continue
+            try:
+                handle = self.tables.add(self.table, self._encode(rule))
+            except Exception as e:  # e.g. table full: keep detecting
+                self._write(now, 'error', rule, repr(e), len(self.rules))
+                continue
+            self.rules[rule] = (handle, now)
+            self._write(now, 'block', rule, 0, len(self.rules))
+
+    def _remove(self, rule, handle, now, event):
+        dropped = -1
+        try:
+            dropped = self.tables.dropped(self.table, handle)
+            self.tables.delete(self.table, handle)
+        except Exception as e:
+            self._write(now, 'error', rule, repr(e), len(self.rules))
+            return
+        del self.rules[rule]
+        self._write(now, event, rule, dropped, len(self.rules))
+
+    def close(self):
+        """Remove every rule and log how many packets each one dropped."""
+        now = self.clock()
+        for rule, (handle, _) in list(self.rules.items()):
+            self._remove(rule, handle, now, 'close')
